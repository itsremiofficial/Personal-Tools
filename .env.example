# Vite server base path (e.g. /Personal-Tools/ for GitHub Pages, / for custom domain)
# Used in vite.config.ts `base` and router `basename`
VITE_BASE_URL=/Personal-Tools/

# Canonical site URL (used in index.html for SEO meta tags)
# Should match the deployed domain, e.g. https://example.com/Personal-Tools/
VITE_SITE_URL=https://itsremiofficial.github.io/Personal-Tools/
